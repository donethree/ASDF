{
  // Type checking only: Node runs the .ts files directly by stripping their types, so nothing is emitted.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "hooks/**/*.ts", "tests/**/*.ts", "skills/systematic-debugging/find-polluter.ts"]
}
